#!/usr/bin/env bash
# Auto-generated by ament_uv_virtualenv. DO NOT EDIT.
#
# Wrapper for @SCRIPT_BASENAME@ that exec's the package-local venv's python.
# Layout in the install tree:
#   <prefix>/lib/@PROJECT_NAME@/<wrapper-name>           <- this file
#   <prefix>/@SCRIPTS_DESTINATION@/@SCRIPT_BASENAME@     <- target python script
#   <prefix>/share/@PROJECT_NAME@/@VENV_NAME@/bin/python <- venv interpreter
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# lib/<pkg>/ -> install prefix
PKG_PREFIX="$(cd "${SCRIPT_DIR}/../.." && pwd)"

VENV_PYTHON="${PKG_PREFIX}/share/@PROJECT_NAME@/@VENV_NAME@/bin/python"
TARGET_SCRIPT="${PKG_PREFIX}/@SCRIPTS_DESTINATION@/@SCRIPT_BASENAME@"

if [[ ! -x "${VENV_PYTHON}" ]]; then
  echo "[@PROJECT_NAME@] venv python not found at: ${VENV_PYTHON}" >&2
  echo "[@PROJECT_NAME@] try: colcon build --packages-select @PROJECT_NAME@" >&2
  exit 1
fi
if [[ ! -f "${TARGET_SCRIPT}" ]]; then
  echo "[@PROJECT_NAME@] target script not found at: ${TARGET_SCRIPT}" >&2
  exit 1
fi

# Make the package's OWN Python modules importable. `install(DIRECTORY <pkg>
# DESTINATION share/<pkg>)` puts them at share/<pkg>/<pkg>/, which nothing else
# adds to sys.path -- so a script doing `from <pkg> import ...` fails under the
# venv interpreter even though `ros2 run` located its wrapper. Prepend that dir,
# preserving any PYTHONPATH `source install/setup.bash` already set (rclpy,
# sibling ament packages), so both the package itself and its ROS deps resolve.
export PYTHONPATH="${PKG_PREFIX}/share/@PROJECT_NAME@${PYTHONPATH:+:${PYTHONPATH}}"

# Keep ~/.local out of the venv's sys.path. `uv venv --system-site-packages`
# sets include-system-site-packages=true, and site.py then also adds the *user*
# site directory -- which is not what we asked for. Any compiled package the
# user happens to have pip-installed there (torchvision, torchaudio, numpy...)
# shadows nothing but still gets imported, and if it was built against a
# different torch/numpy ABI than the venv's, it fails at import time with
# errors like "operator torchvision::nms does not exist". The venv plus the
# system dist-packages (where rclpy lives) is exactly the intended path.
export PYTHONNOUSERSITE=1

exec "${VENV_PYTHON}" "${TARGET_SCRIPT}" "$@"
