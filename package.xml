<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ament_uv_virtualenv</name>
  <version>0.0.1</version>
  <description>
    ament_cmake build-system extension that generates a per-package Python
    virtualenv at colcon build time using uv. Inspired by catkin_virtualenv.
  </description>
  <maintainer email="ab.ioryz@gmail.com">Iori Yanokura</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_export_depend>ament_cmake</buildtool_export_depend>

  <exec_depend>python3-venv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
